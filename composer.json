{
    "name": "internet/intercord",
    "type": "library",
    "description": "A library for sending payloads to discord via webhooks.",
    "keywords": [
        "discord",
        "webhook",
        "embed",
        "rich-embed"
    ],
    "homepage": "https://doctor-internet.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "John Internet",
            "homepage": "https://doctor-internet.dev/",
            "email": "jonjon1234.github@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/JoshPiper/PHP-InterCord/issues",
        "source": "https://github.com/JoshPiper/PHP-InterCord",
        "security": "https://github.com/JoshPiper/PHP-InterCord/security/advisories/new"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Internet\\InterCord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Internet\\InterCord\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-clover=coverage.xml",
        "analyse": "phpstan analyse",
        "lint": "php-cs-fixer check --diff",
        "fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test:coverage": "Run the test suite and write a Clover coverage report.",
        "analyse": "Run static analysis.",
        "lint": "Check coding style without changing files.",
        "fix": "Fix coding style in place."
    }
}
