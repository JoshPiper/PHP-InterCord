{
    "name": "internet/intercord",
    "type": "library",
    "description": "A library for sending payloads to discord via webhooks.",
    "keywords": [
        "discord",
        "webhook",
        "embed",
        "rich-embed"
    ],
    "homepage": "https://doctor-internet.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "John Internet",
            "homepage": "https://doctor-internet.dev/",
            "email": "jonjon1234.github@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/JoshPiper/PHP-InterCord/issues",
        "source": "https://github.com/JoshPiper/PHP-InterCord",
        "security": "https://github.com/JoshPiper/PHP-InterCord/security/advisories/new"
    },
    "require": {
        "php": ">=7.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^6.5.8"
    },
    "require-dev": {
        "phpunit/phpunit": ">=7 <10"
    },
    "autoload": {
        "psr-4": {
            "Internet\\InterCord\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php --colors=never --whitelist src/ --testdox-html test.html --coverage-clover=coverage.xml tests",
        "pcov-polyfill": [
            "@composer require --dev pcov/clobber",
            "pcov clobber"
        ]
    }
}
